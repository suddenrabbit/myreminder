{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myreminder",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myreminder",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
